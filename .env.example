# ============================================================================
# Promo Finder settings. Copy this file to `.env` and paste in your API key(s).
# A command-line flag overrides the value here.
#
# Default: Gemini on its free tier. Free key: https://aistudio.google.com/apikey
# ============================================================================

# Model, as provider[:model]. Providers: gemini, groq, openai, openrouter, together, deepseek,
# mistral, ollama, custom (any OpenAI-compatible endpoint), offline (keyword baseline, no key).
PROMO_MODEL=gemini
PROMO_RPM=8                    # max requests per minute (Gemini free tier), 0 = no limit
PROMO_WORKERS=2                # episodes processed in parallel

# ---------------------------------------------------------------- providers
# Each provider: <NAME>_API_KEY, <NAME>_BASE_URL, <NAME>_MODEL, optional <NAME>_MAX_TOKENS.
# Fill in the key for the one(s) you use.

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=16000        # Gemini 2.5 counts its thinking inside this limit

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_TOKENS=16000        # reasoning models count their thinking inside this limit

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest

# Local models via Ollama (no key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Any other OpenAI-compatible endpoint (e.g. a gateway Kuku provides): PROMO_MODEL=custom
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# ---------------------------------------------------------------- run
PROMO_INPUT=data               # folder of .txt episodes, a .zip, or one .txt
PROMO_OUT_DIR=outputs
PROMO_PER_EPISODE=3            # max promo candidates per episode
PROMO_CACHE=true               # reuse saved answers for identical requests (reruns are free)
PROMO_CACHE_DIR=.cache/llm
PROMO_PRICE_IN=0               # USD per 1M input tokens, for the cost line in the report
PROMO_PRICE_OUT=0              # USD per 1M output tokens

# ---------------------------------------------------------------- the brief's rules
# The prompts are generated from these, so the model is told the same rules the code enforces.
PROMO_MIN_SECONDS=20
PROMO_MAX_SECONDS=60
PROMO_HOOK_WINDOW=3            # hook must start within this many seconds of the clip start

# ---------------------------------------------------------------- model calls
PROMO_MAX_TOKENS=8000          # output limit when <PROVIDER>_MAX_TOKENS isn't set
PROMO_TEMPERATURE=0.3          # low randomness, for consistent picks
PROMO_TIMEOUT=180              # seconds per request
PROMO_MAX_RETRIES=5            # on rate limits / server errors / network drops
PROMO_RETRY_MAX_WAIT=60        # longest wait between retries, even if the provider asks for longer

# ---------------------------------------------------------------- validation details
PROMO_LENGTH_TOLERANCE=0.5     # seconds of slack on the min/max length
PROMO_CLIFF_TAIL=4             # reaction shot allowed after the cliffhanger line (seconds)
PROMO_MAX_SEGMENTS=3           # pieces of one episode a promo may join
PROMO_MIN_SEGMENT_SECONDS=1    # a piece shorter than this is rejected
PROMO_SAFETY_MARGIN_SECONDS=2  # the keyword baseline aims this far inside the length limits
PROMO_REORDER_WARN_SECONDS=0.5 # parser: warn when script blocks are this far out of time order

# ---------------------------------------------------------------- pipeline
PROMO_INCLUDE_CAMERA=true      # camera lines in the prompt (false = fewer tokens, loses visual hooks)
PROMO_STORY_WINDOW=3           # previous episodes' loglines given as context
PROMO_SHORTLIST=30             # promos the ranking model sees
PROMO_TOP=15                   # how many it puts in order
PROMO_DEDUPE_OVERLAP=0.8       # duplicate if it shares more than this much screen time with a better one...
PROMO_DEDUPE_SAME_MOMENT_SECONDS=2  # ...or its hook or cliffhanger is within this many seconds of one
PROMO_BLIND_CHECK_TOP=30       # blind standalone check on the top N, before ranking (= PROMO_SHORTLIST,
                               # so every clip the ranking model sees has been blind-checked)
PROMO_BLIND_FAIL_BELOW=5       # blind score below this adds a 'blind check failed' warning
PROMO_TOP_CAP_N=10             # variety rule: in the top N posts...
PROMO_TOP_MAX_PER_EPISODE=2    # ...at most this many promos from one episode...
PROMO_TOP_EPISODE_SPREAD=2     # ...counting episodes within ±this many as the same storyline

# ---------------------------------------------------------------- scoring
PROMO_SCORE_WEIGHTS=0.40,0.35,0.25   # weight of the model's hook, cliffhanger and standalone scores
PROMO_SWEET_SPOT_MIN_SECONDS=25      # ideal length, told to the model (also used by the keyword baseline)
PROMO_SWEET_SPOT_MAX_SECONDS=50
